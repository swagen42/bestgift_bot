# Создайте бота у @BotFather. Никому не передавайте настоящий токен.
BOT_TOKEN=123456789:replace_with_your_bot_token
# Личный чат владельца (положительный ID) или закрытая группа (-100...).
OWNER_CHAT_ID=123456789
# ID людей, которым разрешено менять статусы. Для личного чата можно не задавать.
# Для группы обязательно укажите хотя бы одного администратора, через запятую.
ADMIN_USER_IDS=
# Публичное имя владельца, с @ или без @.
OWNER_CONTACT=@your_username
# Локально используется папка data. На Bothost укажите DATA_DIR=/app/data.
DATA_DIR=data
# Необязательно: явный путь к БД имеет приоритет над DATA_DIR.
# DATABASE_PATH=data/bestgift.sqlite3
CATALOG_PATH=catalog.toml
# Часовой пояс для времени в уведомлениях. В базе время хранится в UTC.
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
MAX_ATTACHMENTS=30
